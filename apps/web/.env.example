# Local AI (Ollama). The browser never talks to Ollama directly: the app's
# /api/ai/* routes proxy requests using these server-side settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
# Set to "disabled" on deployments without an AI provider (e.g. Vercel without Ollama).
# AI_PROVIDER=disabled
